<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LauncherTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#080808</item>
        <item name="android:colorBackground">#080808</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">@color/red_accent</item>
        <item name="colorAccent">@color/red_accent</item>
    </style>

    <style name="LauncherTheme.Dialog" parent="LauncherTheme">
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>

    <style name="ShortcutMenuAnimation">
        <item name="android:windowEnterAnimation">@anim/shortcut_menu_enter</item>
        <item name="android:windowExitAnimation">@anim/shortcut_menu_exit</item>
    </style>
</resources>
